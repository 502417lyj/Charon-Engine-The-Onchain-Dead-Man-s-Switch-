```env
# ==========================================================
# Charon Engine - Environment Configuration
# ==========================================================

# 1. OKX Onchain OS (For Pulse Checking & Aggregator Routing)
OKX_API_KEY="your-okx-developer-api-key"
OKX_SECRET_KEY="your-okx-secret-key"
OKX_PASSPHRASE="your-okx-passphrase"
OKX_RPC_URL="https://rpc.xlayer.tech"

# 2. OpenClaw NLP Engine (For Will Decryption)
LLM_API_KEY="sk-your-llm-key-here"
LLM_MODEL="gpt-5.4-turbo"

# 3. Protocol Safety Parameters
# Maximum days of inactivity before triggering the Cyber-Will
HEARTBEAT_TIMEOUT_DAYS=180
# The address of the deployed Charon Vault (AA Wallet)
VAULT_CONTRACT_ADDRESS="0xYourSmartAccountAddress..."
